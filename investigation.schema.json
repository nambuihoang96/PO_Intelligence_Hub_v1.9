{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "executive_summary",
    "findings",
    "next_steps",
    "missing_evidence",
    "limitations",
    "opportunity_drafts"
  ],
  "properties": {
    "action_id": {
      "type": "integer"
    },
    "executive_summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "type",
          "confidence",
          "evidence_urls"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "priority",
          "validation_step"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "validation_step": {
            "type": "string"
          }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opportunity_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "user_problem",
          "hypothesis",
          "confidence",
          "impact",
          "validation_step",
          "evidence_urls"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "user_problem": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "validation_step": {
            "type": "string"
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}